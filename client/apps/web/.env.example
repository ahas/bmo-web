# The console's settings (docs/web.md, 「Settings」; docs/boundary.md, 「Settings」). This file is the sample;
# the deployment's own environment file stands in the data root, outside every checkout.

# The port the built server listens on. The bun preset reads PORT (NITRO_PORT wins over it).
PORT=

# Sealed-cookie key for the login session. At least 32 characters, secret, and stable: changing it logs
# everyone out. Make one with: openssl rand -base64 48
NUXT_SESSION_PASSWORD=change-me-to-at-least-32-characters-long

# The base path every page stands under; /bmo/ where none is named.
# BMO_WEB_BASE_URL=/bmo/

# The server's PostgreSQL database, where the console's own tables stand beside sumida's.
WEB_DATABASE_URL=

# The name the chat agent's messages stand under, and the label a room calls it by.
NUXT_PUBLIC_CHAT_AGENT_NAME=
NUXT_PUBLIC_CHAT_AGENT_LABEL=

# The console's public address: the scheme, the public name and the base path, as https://console.example/bmo/.
# A link under it in a room is read as the console's own, and a unit that writes such a link is given the same address.
NUXT_PUBLIC_CONSOLE_ADDRESS=

# The desktop app's release read, the JSON file naming its current release: the public one is
# https://github.com/ahas/jake/releases/latest/download/release.json. With none set, the download page says no release
# is published.
# DESKTOP_RELEASE_URL=

# The server's binary and the folder its settings stand in, which the account script runs where the account
# model is in force.
# BMO_WEB_SERVER_BIN=
# BMO_WEB_SERVER_DIR=

# The console's own data folder, inside no checkout: the keys a send is held once by.
WEB_DATA_DIR=

# The units the console's server calls, each by its base address and the token it is called with. A unit
# whose address is not set is a unit the console does not reach: its screens stand as for a unit not yet
# split, and no call is made.
WEB_SERVER_ADDRESS=
WEB_SERVER_TOKEN=
AGENCY_ADDRESS=
AGENCY_TOKEN=
JOB_ADDRESS=
JOB_TOKEN=
RECEIVER_ADDRESS=
RECEIVER_TOKEN=
BRAIN_ADDRESS=
BRAIN_TOKEN=
ARTIFACT_ADDRESS=
ARTIFACT_TOKEN=
MAIL_ADDRESS=
MAIL_TOKEN=
REVIEW_ADDRESS=
REVIEW_TOKEN=
DRIVE_ADDRESS=
DRIVE_TOKEN=
REMOTE_ADDRESS=
REMOTE_TOKEN=
RESEARCH_ADDRESS=
RESEARCH_TOKEN=
# The cache siren and the cache warmer take no token.
CACHE_SIREN_ADDRESS=
CACHE_WARMER_ADDRESS=
# The consumer the agency registers its targets under at the cache warmer, which an agent's own keepalive switch
# stands under; with none, only the whole round is switched.
KEEPALIVE_CONSUMER=

# The testbed's progress record, which the deployment mark in the title bar reads.
DEPLOY_PROGRESS_FILE=

# The document viewer's roots: a JSON list of checkouts, each its key, the label the list shows it under and the
# absolute top of the checkout, whose docs/ and upper-case markdown at the top are read, in the order the list
# stands them. The list is quoted whole in single quotes, since the unit's environment file and the build's shell
# both read this file and would otherwise strip the JSON's own quotes.
# DOCUMENT_ROOTS='[{"key":"web","label":"Web console","checkout":"/home/user/checkouts/web"}]'
DOCUMENT_ROOTS=

# The keys this console signs its push notifications with, made by: bun scripts/vapid.ts
# The public half goes out to every browser that subscribes and the private half signs, so it stays here.
# Without both, the console says plainly that it cannot ring and everything else works as before. Making a
# new pair invalidates every subscription made against the old one.
# BMO_VAPID_PUBLIC_KEY=
# BMO_VAPID_PRIVATE_KEY=
# Who to reach about a push from this server, which the push services ask for. A mailto: or an https:
# address; the default names this machine and no person.
# BMO_VAPID_SUBJECT=mailto:bmo@localhost

# Whether a console served from source rings the devices. A built console always does; one being worked
# in does not, because the two would ring for the same event and every notice would come twice. Set this
# to ring from a development server as well.
# BMO_PUSH_IN_DEV=1

# The hosts a development server answers beyond its own, comma-separated.
# BMO_WEB_DEV_HOSTS=
