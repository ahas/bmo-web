+// An item may hold its children's open set itself: `childrenOpen`, the values of its children standing open,
+// and `onUpdateChildrenOpen`, handed the set each time a child opens or closes. Its nested region then stands
+// as that set says for as long as it stands, so a child that comes later stands as the item says too. A region
+// whose item holds no set reads its children's `defaultOpen` once, as it first stands.
+function getNestedAccordionProps(item, level, listIndex) {
