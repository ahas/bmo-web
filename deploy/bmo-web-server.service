# The server's user unit (docs/accounts.md, 「Where it answers」). A deployment links it from the deploy tree and
# restarts it as the repository's one service, waited on by its health; it runs the release binary as `serve` in the
# release's server/, whose settings.local.toml each release links to the data root's env/web.toml.
[Unit]
Description=bmo-web-server: the account service on sumida and the language packs' fixed lines
After=network-online.target
Wants=network-online.target
# Without its settings the server does not stand, so the unit does not start where the data root holds none.
ConditionPathExists=%h/.local/share/bmo/data/env/web.toml

[Service]
Type=simple
WorkingDirectory=%h/.local/share/bmo-web/deploy/server
ExecStart=%h/.local/share/bmo-web/deploy/bin/bmo-web-server serve
Restart=always
RestartSec=2
# The server ends on SIGTERM once the requests it holds have answered; a stop waits for that end.
TimeoutStopSec=infinity

[Install]
WantedBy=default.target
# The service: linked, enabled, restarted and waited on by every deployment.
X-BMO-Deploy=bot
